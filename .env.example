# ============================================================
# Environment Configuration for PBL-3 Patent & Research Gap
# ============================================================

# LLM Provider: 'mock' (offline/deterministic) or 'openai'
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Embedding Model (Sentence-Transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEVICE=cpu

# Vector Store Engine: 'faiss'
VECTOR_STORE=faiss

# Retrieval Parameters
TOP_K_PATENTS=3
TOP_K_PAPERS=3
SIMILARITY_THRESHOLD=0.25

# Chunking Parameters
CHUNK_SIZE=600
CHUNK_OVERLAP=80

# Generation Parameters
TEMPERATURE=0.2
MAX_TOKENS=2048

# Directories
DATA_DIR=data
VECTOR_STORE_DIR=vector_store
PROCESSED_DATA_DIR=data/processed

# Novelty Weighting Scheme (Configurable Prototype Heuristic Parameters - Not Empirically Validated)
NOVELTY_WEIGHT_SEMANTIC=0.40
NOVELTY_WEIGHT_TECHNICAL=0.35
NOVELTY_WEIGHT_CLAIM=0.25

# Semantic Feature Comparison Thresholds (Configurable Prototype Similarity Thresholds)
FEATURE_MATCH_THRESHOLD=0.55
FEATURE_PARTIAL_THRESHOLD=0.38
FEATURE_UNCERTAIN_THRESHOLD=0.28
